# ── Database (Turso / libSQL) ─────────────────────────────────────
# Create a database at https://turso.tech → Databases → Create.
# Get the URL + token: turso db show <name> --url   and   turso db tokens create <name>
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
# For local dev you can use a local file instead (no token needed):
# TURSO_DATABASE_URL="file:./local.db"

# ── NextAuth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="https://tasdi.foo"

# ── Google OAuth (for customer "Continue with Google") ──────────────
# Create at https://console.cloud.google.com/apis/credentials → OAuth client ID → Web app
# Authorized redirect URI: https://tasdi.foo/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Admin password reset email (optional) ───────────────────────────
# If set, "Forgot password?" on /admin/login emails a reset link.
# If NOT set, the reset link is written to the server logs instead
# (Vercel → your project → Logs) so you can still recover access.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Justice Connect <you@example.com>"

# ── Admin bootstrap (optional) ──────────────────────────────────────
# If set, /admin/setup is skipped and this admin account is seeded on first boot.
# Otherwise create the admin at https://tasdi.foo/admin/setup after deploy.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"
